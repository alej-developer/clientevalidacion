# === Configuracion de la Aplicacion ===
APP_NOMBRE="ClienteValidacion API"
APP_VERSION="0.2.0"
APP_DESCRIPCION="API REST profesional con FastAPI"
APP_DEBUG=true

# === Base de Datos ===
BD_URL="sqlite+aiosqlite:///./desarrollo.db"
BD_ECHO=false

# === CORS ===
CORS_ORIGENES='["http://localhost:3000","http://localhost:5173"]'

# === Cookie de autenticacion ===
# Comentado = automatico: cookie Secure salvo en desarrollo (APP_DEBUG=true)
# COOKIE_SEGURA=true

# === Logging ===
LOG_NIVEL="DEBUG"

# === JWT ===
# Obligatorio. La aplicacion no arranca si JWT_SECRETO falta o esta vacio.
# Genera un valor aleatorio y pegalo aqui (no reutilices secretos de ejemplo):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
JWT_EXPIRACION_MINUTOS=60
# Duracion del refresh token en dias
JWT_REFRESH_EXPIRACION_DIAS=30

# === Rate Limiting ===
LIMITE_POR_DEFECTO="60/minute"
LIMITE_AUTH="10/minute"
